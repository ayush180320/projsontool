{
  "name": "json-studio-pro",
  "version": "1.0.0",
  "description": "Media-grade JSON viewer, visualizer and CSV exporter",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.jsonstudiopro.app",
    "productName": "JSON Studio Pro",
    "copyright": "Copyright © 2024",
    "directories": { "output": "dist" },
    "files": ["src/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "author": "JSON Studio Pro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
